{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word",
    "tree": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low"
  },
  "animations": true,
  "tabs": {
    "indicators": "status",
    "layout": "horizontal",
    "enabled": true
  },
  "terminal": {
    "title": true
  },
  "debug": {
    "devtools": false
  }
}
