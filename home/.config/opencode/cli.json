{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "fullscreen": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "permissions": "prompt",
    "image_preview": true
  },
  "animations": true,
  "tabs": {
    "indicators": "status",
    "layout": "horizontal",
    "enabled": true,
    "mode": "off",
    "scope": "cwd"
  },
  "terminal": {
    "title": true
  },
  "debug": {
    "devtools": false
  },
  "highlights": true,
  "prompt": {
    "image_preview": true
  }
}
